# Cổng chạy server
PORT=3000

# Tùy chọn: gửi email thông báo booking (chỉ gửi khi đủ các biến SMTP_HOST, SMTP_USER, SMTP_PASS, BOOKING_NOTIFY_TO)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BOOKING_NOTIFY_TO=

# Tùy chọn: đường dẫn file lưu booking (mặc định data/bookings.json)
BOOKINGS_FILE=

# Cấu hình tích hợp OTA
# Danh sách domain OTA được phép gọi API (phân cách bởi dấu phẩy, để trống hoặc '*' để cho phép tất cả)
OTA_ALLOWED_ORIGINS=http://localhost:3001,https://ota.banla.vn

# API key bảo mật xác thực request từ phía sàn OTA (để trống nếu không bật xác thực)
OTA_API_KEY=

# Website tĩnh (banlaboutiquedalat.com) gọi Supabase Function `banla-payment`.
# Đặt cùng các biến PayPal/OnePay/9Pay bên dưới thành Supabase secrets để nút thanh toán mở trang nhập thẻ.
# Thanh toán thẻ — chỉ trên trang PayPal, OnePay hoặc 9Pay.
# Không điền số thẻ, ngày hết hạn, CVV vào đây. Không commit secret thật.
# sandbox là mặc định. Chỉ đặt CARD_PAYMENT_MODE=live sau khi chủ cửa hàng xác nhận.
CARD_PAYMENT_MODE=sandbox
PUBLIC_BASE_URL=http://localhost:3000

# PayPal REST app (sandbox và live tách riêng). PAYPAL_CURRENCY để trống = dùng VND của hóa đơn.
# Không tự đổi tỷ giá. PayPal có thể từ chối VND; khi đó khách thanh toán VND qua OnePay.
PAYPAL_CURRENCY=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=

# OnePay hosted redirect. Merchant / Access Code / Hash do OnePay cấp. Không dán hash vào git.
ONEPAY_SANDBOX_MERCHANT=
ONEPAY_SANDBOX_ACCESS_CODE=
ONEPAY_SANDBOX_HASH_KEY=
ONEPAY_SANDBOX_URL=https://mtf.onepay.vn/paygate/vpcpay.op
ONEPAY_LIVE_MERCHANT=
ONEPAY_LIVE_ACCESS_CODE=
ONEPAY_LIVE_HASH_KEY=
ONEPAY_LIVE_URL=https://onepay.vn/paygate/vpcpay.op

# 9Pay hosted redirect (Visa/Mastercard/JCB/Amex, Apple Pay, Google Pay, Samsung Pay, QR).
# Tắt mặc định. Chỉ đặt NINEPAY_ENABLED=true sau khi đã có key và đã thử sandbox.
# Merchant Key, Secret Key và Checksum Key do 9Pay cấp. Không dán secret vào git.
# IPN đăng ký trên Merchant View, không nhúng secret vào URL.
NINEPAY_ENABLED=false
NINEPAY_SANDBOX_MERCHANT_KEY=
NINEPAY_SANDBOX_SECRET_KEY=
NINEPAY_SANDBOX_CHECKSUM_KEY=
NINEPAY_SANDBOX_URL=https://sand-payment.9pay.vn
NINEPAY_LIVE_MERCHANT_KEY=
NINEPAY_LIVE_SECRET_KEY=
NINEPAY_LIVE_CHECKSUM_KEY=
NINEPAY_LIVE_URL=https://payment.9pay.vn

# Cấu hình API Key cho Cross-Reviewer Subagent (Grok & Codex)
# Lấy API key tại: https://console.x.ai/ (xAI) và https://platform.openai.com/ (OpenAI)
XAI_API_KEY=
OPENAI_API_KEY=


# Cổng chạy server
PORT=3000

# Tùy chọn: gửi email thông báo booking (chỉ gửi khi đủ các biến SMTP_HOST, SMTP_USER, SMTP_PASS, BOOKING_NOTIFY_TO)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BOOKING_NOTIFY_TO=

# Tùy chọn: đường dẫn file lưu booking (mặc định data/bookings.json)
BOOKINGS_FILE=

# Cấu hình tích hợp OTA
# Danh sách domain OTA được phép gọi API (phân cách bởi dấu phẩy, để trống hoặc '*' để cho phép tất cả)
OTA_ALLOWED_ORIGINS=http://localhost:3001,https://ota.banla.vn

# API key bảo mật xác thực request từ phía sàn OTA (để trống nếu không bật xác thực)
OTA_API_KEY=

# Cấu hình API Key cho Cross-Reviewer Subagent (Grok & Codex)
# Lấy API key tại: https://console.x.ai/ (xAI) và https://platform.openai.com/ (OpenAI)
XAI_API_KEY=
OPENAI_API_KEY=

# Bảo mật Quản trị & Webhook nội bộ (tối thiểu 12 ký tự cho ADMIN_KEY)
ADMIN_KEY=
ADMIN_SESSION_SECRET=
BANLA_WEBHOOK_SECRET=

# Cấu hình Cổng thanh toán Thẻ Quốc Tế OnePay VPC v2 (Visa / Mastercard / Amex / JCB)
# Sandbox URL thử nghiệm: https://mtf.onepay.vn/vpcpay/vpcpay.op
# TUYỆT ĐỐI KHÔNG đưa ONEPAY_SECURE_SECRET xuống trình duyệt hoặc commit lên Git
APP_BASE_URL=http://localhost:3000
ONEPAY_MERCHANT_ID=
ONEPAY_ACCESS_CODE=
ONEPAY_SECURE_SECRET=
ONEPAY_PAYMENT_URL=https://mtf.onepay.vn/vpcpay/vpcpay.op
ONEPAY_CURRENCY=VND

# Tùy chọn: Kết nối Supabase PostgreSQL (chỉ dùng schema `banla` phía Backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=



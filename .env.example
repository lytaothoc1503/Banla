# Cổng chạy server
PORT=3000

# Tùy chọn: gửi email thông báo booking (chỉ gửi khi đủ các biến SMTP_HOST, SMTP_USER, SMTP_PASS, BOOKING_NOTIFY_TO)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BOOKING_NOTIFY_TO=

# Tùy chọn: đường dẫn file lưu booking (mặc định data/bookings.json)
BOOKINGS_FILE=

# Cấu hình tích hợp OTA
# Danh sách domain OTA được phép gọi API (phân cách bởi dấu phẩy, để trống hoặc '*' để cho phép tất cả)
OTA_ALLOWED_ORIGINS=http://localhost:3001,https://ota.banla.vn

# API key bảo mật xác thực request từ phía sàn OTA (để trống nếu không bật xác thực)
OTA_API_KEY=

# Cấu hình API Key cho Cross-Reviewer Subagent (Grok & Codex)
# Lấy API key tại: https://console.x.ai/ (xAI) và https://platform.openai.com/ (OpenAI)
XAI_API_KEY=
OPENAI_API_KEY=

